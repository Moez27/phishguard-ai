# PhishGuard AI — example configuration
# Copy to `.env` and adjust. `.env` is git-ignored: never commit real secrets.
# Every value below is optional; the defaults are shown.

# Paths (relative paths are resolved from the project root)
# PHISHGUARD_DATA_DIR=data
# PHISHGUARD_MODELS_DIR=models
# PHISHGUARD_REPORTS_DIR=reports
# PHISHGUARD_DB_PATH=data/phishguard.db

# Input limits
# PHISHGUARD_MAX_EMAIL_CHARS=100000
# PHISHGUARD_MAX_UPLOAD_BYTES=204800
# PHISHGUARD_MAX_URL_LENGTH=2048

# Risk score thresholds (0 < suspect < phishing < 1)
# PHISHGUARD_SUSPECT_THRESHOLD=0.40
# PHISHGUARD_PHISHING_THRESHOLD=0.70
# Share of the ML probability in the email risk score (0-1); the rest comes from rules
# PHISHGUARD_ML_WEIGHT=0.50

# Machine learning
# PHISHGUARD_RANDOM_SEED=42
# PHISHGUARD_TEST_SIZE=0.20

# Privacy: keep false to avoid storing full email bodies in the history
# PHISHGUARD_STORE_EMAIL_BODY=false

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# PHISHGUARD_LOG_LEVEL=INFO
